# Variables d'environnement pour le déploiement

# URL RPC pour se connecter à la blockchain (Infura, Alchemy, etc.)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Project ID WalletConnect (obtenir sur https://cloud.walletconnect.com/)
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Adresse du smart contract déployé sur le réseau
CONTRACT_ADDRESS=0xYourContractAddress

# Environnement (development ou production)
NODE_ENV=production
